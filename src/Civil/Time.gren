module Civil.Time exposing
    ( Time
    , fraction
    , fromParts
    , fromString
    , hour
    , midnight
    , millisecond
    , minute
    , nanosecond
    , second
    , secondOfDay
    , toString
    , toStringWithPlaces
    )

{-| A time of day, with no date and no time zone.

`17:45:00` is a time of day. It is not a moment in time and it is not a
duration. It comes around once a day everywhere, at a different moment in each
place, and on the day a time zone changes its clocks it can come around twice
or not at all. It is a reading on a clock: what RFC 3339 calls a
`partial-time`, and what someone means when they write down when a shop opens.


## Seconds are optional, fractions are unlimited

TOML 1.1 makes the seconds field optional, as ISO 8601 does and RFC 3339 does
not. This module follows TOML: `13:37` parses, and is written back as
`13:37:00`, because the written form always has all three fields. Neither
standard limits the number of digits after the decimal point, and neither does
this module.

The fraction is kept as text, however many digits it has, so nothing is
rounded away. Trailing zeroes are dropped, so that `==` compares the time
rather than the spelling: `10:32:00.5` and `10:32:00.50` are the same value.
If you need the original spelling, keep the source text; a value cannot hold
both.


## Leap seconds

A second of `60` is accepted, because RFC 3339 allows it and a timestamp that
records a leap second is valid. It is stored and written back as `60`. This
module does no arithmetic that would need to decide what a leap second means:
[`secondOfDay`](#secondOfDay) returns `86400` for `23:59:60`, one past the
last ordinary second of the day.

The `60` is checked as a field on its own, not as part of an `HH:MM:SS` that
has to read `23:59:60`. `12:30:60` is a time here, and `secondOfDay` gives it
`45060`. That is RFC 3339's grammar, which allows `60` in the seconds field
and leaves the question of whether a leap second was really inserted at that
instant to whoever knows. It has to: a leap second falls at `23:59:60` UTC,
which is some other wall clock at every other offset, so the same second is
`1990-12-31T15:59:60-08:00` in California.

@docs Time


## Creating

@docs fromParts, midnight


## Reading

@docs hour, minute, second, fraction, millisecond, nanosecond, secondOfDay


## Strings

@docs fromString, toString, toStringWithPlaces

-}

import Basics exposing (..)
import Char
import Maybe exposing (Maybe(..))
import String


{-| A time of day.
-}
@derive(Eq, Inspect)
type Time
    = Time
        { hour : Int
        , minute : Int
        , second : Int
        , fraction : String
        }


-- CREATING


{-| A time from its parts. The fraction is the digits after the decimal point,
without the point itself, or `""` for no fraction.

    Time.fromParts { hour = 10, minute = 32, second = 0, fraction = "555" }
        |> Maybe.map Time.toString
    --> Just "10:32:00.555"

`Nothing` if the hour is outside 0 to 23, the minute outside 0 to 59, the second
outside 0 to 60, or the fraction is anything but digits.

Trailing zeroes are dropped from the fraction, so a fraction of `"5550"` gives
the same value as `"555"`.

The fraction is a `String` and not an `Int` because its digits are positional
and a number loses that. `"5"` is half a second and `"05"` is a twentieth of
one, but both are the number 5; only the text says where after the point the
digits start.

    Time.fromParts { hour = 10, minute = 32, second = 0, fraction = "05" }
        |> Maybe.map Time.toString
    --> Just "10:32:00.05"

A number would also have to fix a unit and a precision, milliseconds or
nanoseconds or some other, and the number of digits here is not limited, so
everything past that unit would be rounded away. Text keeps every digit that
was written.
[`millisecond`](#millisecond) and [`nanosecond`](#nanosecond) are there for
when a number is what you want.

-}
fromParts : { hour : Int, minute : Int, second : Int, fraction : String } -> Maybe Time
fromParts parts =
    if parts.hour < 0 || parts.hour > 23 then
        Nothing

    else if parts.minute < 0 || parts.minute > 59 then
        Nothing

    else if parts.second < 0 || parts.second > 60 then
        Nothing

    else if not (String.all Char.isDigit parts.fraction) then
        Nothing

    else
        Just
            (Time
                { hour = parts.hour
                , minute = parts.minute
                , second = parts.second
                , fraction = trimZeroes parts.fraction
                }
            )


{-| `00:00:00`.
-}
midnight : Time
midnight =
    Time { hour = 0, minute = 0, second = 0, fraction = "" }


trimZeroes : String -> String
trimZeroes text =
    if String.endsWith "0" text then
        trimZeroes (String.dropLast 1 text)

    else
        text


-- READING


{-| The hour, 0 to 23.
-}
hour : Time -> Int
hour (Time parts) =
    parts.hour


{-| The minute, 0 to 59.
-}
minute : Time -> Int
minute (Time parts) =
    parts.minute


{-| The second, 0 to 60. Sixty is a leap second.
-}
second : Time -> Int
second (Time parts) =
    parts.second


{-| The digits after the decimal point, without the point, with trailing zeroes
already removed. `""` when there is no fraction.

    Time.fromString "10:32:00.5500" |> Maybe.map Time.fraction
    --> Just "55"

-}
fraction : Time -> String
fraction (Time parts) =
    parts.fraction


{-| The fraction as whole milliseconds, truncated.

    Time.fromString "10:32:00.5559" |> Maybe.map Time.millisecond
    --> Just 555

-}
millisecond : Time -> Int
millisecond time =
    fractionAsInt 3 time


{-| The fraction as whole nanoseconds, truncated. Digits past the ninth are
dropped; [`fraction`](#fraction) keeps them all.

    Time.fromString "10:32:00.5" |> Maybe.map Time.nanosecond
    --> Just 500000000

-}
nanosecond : Time -> Int
nanosecond time =
    fractionAsInt 9 time


fractionAsInt : Int -> Time -> Int
fractionAsInt places (Time parts) =
    if parts.fraction == "" then
        0

    else
        parts.fraction
            |> String.takeFirst places
            |> String.padRight places '0'
            |> String.toInt
            |> Maybe.withDefault 0


{-| Seconds since midnight, ignoring the fraction.

    Time.fromString "01:00:00" |> Maybe.map Time.secondOfDay
    --> Just 3600

A leap second gives `86400`, one past the last ordinary second of the day.
See the note on leap seconds at the top of this module.

-}
secondOfDay : Time -> Int
secondOfDay (Time parts) =
    parts.hour * 3600 + parts.minute * 60 + parts.second


-- STRINGS


{-| Read an `HH:MM`, `HH:MM:SS`, or `HH:MM:SS.fff` time.

    Time.fromString "13:37" |> Maybe.map Time.toString
    --> Just "13:37:00"

Each field has to be exactly two digits, the fraction at least one, and the
whole string has to be the time. All of these are `Nothing`:

    Time.fromString "1:37:00"    --> Nothing
    Time.fromString "13:37:00."  --> Nothing
    Time.fromString "133700"     --> Nothing
    Time.fromString "13:37:00Z"  --> Nothing

-}
fromString : String -> Maybe Time
fromString str =
    let
        dot =
            String.firstIndexOf "." str

        { first = clock, rest = fractionPart } =
            when dot is
                Just at ->
                    { first = String.takeFirst at str
                    , rest = String.dropFirst (at + 1) str
                    }

                Nothing ->
                    { first = str, rest = "" }

        fractionOk =
            when dot is
                Just _ ->
                    fractionPart /= "" && String.all Char.isDigit fractionPart

                Nothing ->
                    True
    in
    if not fractionOk then
        Nothing

    else
        when String.split ":" clock is
            [ hourText, minuteText ] ->
                -- RFC 3339 hangs time-secfrac off time-second, so a fraction
                -- with no seconds to attach to is not a time.
                if fractionPart == "" then
                    build hourText minuteText "00" ""

                else
                    Nothing

            [ hourText, minuteText, secondText ] ->
                build hourText minuteText secondText fractionPart

            _ ->
                Nothing


build : String -> String -> String -> String -> Maybe Time
build hourText minuteText secondText fractionText =
    if String.count hourText /= 2 || String.count minuteText /= 2 || String.count secondText /= 2 then
        Nothing

    else
        Maybe.map3
            (\h m s ->
                { hour = h, minute = m, second = s, fraction = fractionText }
            )
            (digits hourText)
            (digits minuteText)
            (digits secondText)
            |> Maybe.andThen fromParts


digits : String -> Maybe Int
digits text =
    if String.all Char.isDigit text then
        String.toInt text

    else
        Nothing


{-| Write an `HH:MM:SS` time, with `.fff` after it when there is a fraction.

    Time.fromString "13:37" |> Maybe.map Time.toString
    --> Just "13:37:00"

The seconds are always written, even when the value was read from text that
had none. The fraction is written without its trailing zeroes.

-}
toString : Time -> String
toString (Time parts) =
    let
        clock =
            pad parts.hour ++ ":" ++ pad parts.minute ++ ":" ++ pad parts.second
    in
    if parts.fraction == "" then
        clock

    else
        clock ++ "." ++ parts.fraction


{-| Write an `HH:MM:SS` time with the fraction padded or truncated to a fixed
number of places.

    Time.fromString "13:37" |> Maybe.map (Time.toStringWithPlaces 3)
    --> Just "13:37:00.000"

    Time.fromString "10:32:00.5" |> Maybe.map (Time.toStringWithPlaces 3)
    --> Just "10:32:00.500"

With zero places, no decimal point is written. Use this when the receiver
requires a fixed number of places, such as exactly three for milliseconds.
Otherwise use [`toString`](#toString).

-}
toStringWithPlaces : Int -> Time -> String
toStringWithPlaces places (Time parts) =
    let
        clock =
            pad parts.hour ++ ":" ++ pad parts.minute ++ ":" ++ pad parts.second
    in
    if places <= 0 then
        clock

    else
        clock
            ++ "."
            ++ (parts.fraction
                    |> String.takeFirst places
                    |> String.padRight places '0'
               )


pad : Int -> String
pad n =
    String.padLeft 2 '0' (String.fromInt n)
